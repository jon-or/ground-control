{
  "manifest_version": 3,
  "name": "Ground Control — GitHub board overlay",
  "version": "0.0.0",
  "description": "Shows the agent sessions running on your machine on your team's GitHub project board.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms", "storage"],
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.js", "src/state.js"],
      "matches": ["https://github.com/*"]
    }
  ]
}
