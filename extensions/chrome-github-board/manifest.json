{
  "manifest_version": 3,
  "name": "Ground Control — GitHub board overlay",
  "version": "0.0.0",
  "description": "Shows local agent sessions on GitHub project boards.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms", "storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.js", "src/state.js", "src/preferences.js"],
      "matches": ["https://github.com/*"]
    }
  ]
}
