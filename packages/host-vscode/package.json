{
  "name": "@ground-control/host-vscode",
  "version": "0.0.0",
  "private": true,
  "description": "The VS Code host adapter's headless half: which window and surface holds a session, and the plan for reaching it. Must not import vscode.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ground-control/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
