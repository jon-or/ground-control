{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ground-control extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/ground-control"],
      "outFiles": ["${workspaceFolder}/extensions/ground-control/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
