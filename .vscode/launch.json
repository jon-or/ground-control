{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dev-tracker extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/dev-tracker"],
      "outFiles": ["${workspaceFolder}/extensions/dev-tracker/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
